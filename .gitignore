# Business data lives under $RECKON_HOME (default ~/.reckon), never in this
# checkout: orgs, connections, credentials, knowledge, sessions and incidents.
# The entries below cover checkouts from before orgs existed, which kept that
# data here. Move it with `reckon migrate`, then delete it; never commit it,
# and never add a `!` re-include rule here.
.env
.env.*
.config/
/.reckon-env
/infra-knowledge/
/incidents/
/sessions/
/.reckon-demo/
/RCA-*.md
/rca-*.md

# Local agent state for anyone running an agent in the checkout itself.
.claude/
.agents/

__pycache__/
*.pyc
/bin/

# Cloudflare local cache
.wrangler/

# macOS Finder metadata (it can encode the names of ignored folders).
.DS_Store
