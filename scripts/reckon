#!/usr/bin/env bash
# reckon: entry point for this checkout. All logic lives in scripts/reckon.py.
# `reckon open` also links $RECKON_HOME/bin/reckon so the command works anywhere.
set -euo pipefail
command -v python3 >/dev/null 2>&1 || { printf 'reckon: Python 3.9+ (python3) is required\n' >&2; exit 1; }
exec python3 "$(cd "$(dirname "$0")" && pwd)/reckon.py" "$@"
