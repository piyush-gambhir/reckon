#!/usr/bin/env bash
# Run the native executable built from this checkout.
set -euo pipefail
reckon_root="$(cd "$(dirname "$0")/.." && pwd)"
for reckon_binary in "$reckon_root/target/release/reckon" "$reckon_root/target/debug/reckon"; do
    if [ -x "$reckon_binary" ]; then
        exec "$reckon_binary" "$@"
    fi
done
printf 'reckon: build the native CLI first: cargo build --locked --release\n' >&2
exit 1
