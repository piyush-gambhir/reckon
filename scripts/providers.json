      "read_commands": [["user", "tokens", "verify"], ["accounts", "tokens", "verify"], ["accounts", "list"], ["zones", "list"], ["zones", "get"], ["dns", "records", "list"], ["dns", "records", "get"], ["dns", "dnssec", "get"], ["workers", "list"], ["d1", "list"], ["kv", "namespaces", "list"], ["r2", "buckets", "list"], ["queues", "list"], ["rulesets", "list"]],
      "deny_args": ["--profile", "--zone", "-z", "--zone-id", "--zoneId", "--account-id", "--accountId", "--account-name", "--accountName", "--mode", "-m", "--local", "--no-local", "--persist-to", "--persistTo", "--body", "--cf-r2-jurisdiction", "--cfR2Jurisdiction"],
      "deny_prefixes": ["--profile.", "--zone.", "--zone-id.", "--zoneId.", "--account-id.", "--accountId.", "--account-name.", "--accountName.", "--mode.", "--local.", "--no-local.", "--persist-to.", "--persistTo.", "--body.", "--cf-r2-jurisdiction.", "--cfR2Jurisdiction."],
      "deny_commands": [["auth"], ["login"], ["access"], ["tunnels"], ["dev"], ["build"], ["deploy"], ["init"], ["migrate"], ["telemetry"], ["tools"], ["workers", "secrets"], ["accounts", "tokens", "list"], ["accounts", "tokens", "get"]],
      "short_values": "zm",
