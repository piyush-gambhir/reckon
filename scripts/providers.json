      "prefixes": ["REDIS_"],
      "required": ["REDIS_URL"],
      "read_commands": [["info"], ["slowlog", "get"], ["slowlog", "len"], ["dbsize"], ["scan"], ["ping"], ["memory", "stats"], ["memory", "usage"], ["client", "list"], ["type"], ["ttl"], ["pttl"], ["exists"], ["strlen"], ["llen"], ["scard"], ["zcard"], ["hlen"], ["xlen"], ["xinfo", "*"], ["latency", "latest"], ["latency", "history"], ["latency", "doctor"], ["latency", "graph"], ["latency", "histogram"]],
