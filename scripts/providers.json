{
  "schema_version": 1,
  "_comment": "Tools Reckon can connect. mode own: the CLI enforces read-only itself; allowlist: only listed read commands; approval: the agent must ask before each run. Checked against the sibling CLI sources on 2026-10-14.",
  "providers": {
    "grafana": {
      "title": "Grafana",
      "binary": "grafana",
      "mode": "own",
      "prefixes": ["GRAFANA_"],
      "required": ["GRAFANA_URL", "GRAFANA_TOKEN/GRAFANA_PASSWORD"],
      "optional": ["GRAFANA_USERNAME", "GRAFANA_ORG_ID"],
      "config_files": ["grafana-cli/config.yaml"],
      "always": {"GRAFANA_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"GRAFANA_READ_ONLY": "true", "GRAFANA_NO_INPUT": "true"},
      "deny_args": ["--url", "--token", "--username", "--password", "--org-id", "--profile", "--read-only", "--no-input", "--output-file"],
      "deny_commands": [["login"], ["config"], ["update"]],
      "verify": ["org", "current", "-o", "json"],
      "login": ["login"],
      "short_values": "o"
    },
    "jenkins": {
      "title": "Jenkins",
      "binary": "jenkins",
      "mode": "own",
      "prefixes": ["JENKINS_"],
      "required": ["JENKINS_URL", "JENKINS_USER", "JENKINS_TOKEN"],
      "optional": ["JENKINS_INSECURE"],
      "config_files": ["jenkins-cli/config.yaml"],
      "always": {"JENKINS_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"JENKINS_READ_ONLY": "true", "JENKINS_NO_INPUT": "true"},
      "deny_args": ["--server", "--user", "--token", "--insecure", "--profile", "--read-only", "--no-input", "--download", "-s", "-u", "-t", "-k", "-d", "--output-dir"],
      "deny_commands": [["login"], ["config"], ["update"]],
      "verify": ["whoami", "-o", "json"],
      "login": ["login"],
      "short_values": "o",
      "command_short_values": {"job list": "f"}
    },
    "cubeapm": {
      "title": "CubeAPM",
      "binary": "cubeapm",
      "mode": "own",
      "prefixes": ["CUBEAPM_"],
      "required": ["CUBEAPM_SERVER", "CUBEAPM_EMAIL", "CUBEAPM_PASSWORD"],
      "optional": ["CUBEAPM_QUERY_PORT", "CUBEAPM_INGEST_PORT", "CUBEAPM_ADMIN_PORT"],
      "config_files": ["cubeapm-cli/config.yaml"],
      "always": {"CUBEAPM_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"CUBEAPM_READ_ONLY": "true", "CUBEAPM_NO_INPUT": "true"},
      "deny_args": ["--server", "--email", "--password", "--query-port", "--ingest-port", "--admin-port", "--profile", "--read-only", "--no-input", "--verbose"],
      "deny_commands": [["login"], ["config"], ["update"], ["ingest"], ["logs", "delete"]],
      "env_label_flag": "--env",
      "env_label_tags": ["environment", "env"],
      "verify": ["metrics", "query", "1", "-o", "json"],
      "login": ["login"],
      "short_values": "o",
      "env_injected_commands": [["traces", "search"], ["traces", "services"]],
      "env_scoped_commands": [["metrics", "query"], ["metrics", "query-range"], ["logs", "query"], ["logs", "hits"], ["logs", "stats"]],
      "ndjson_commands": [["logs", "query"]],
      "aliases": {"metric": "metrics", "trace": "traces", "log": "logs", "range": "query-range", "svc": "services"},
      "env_label_families": ["metrics", "logs", "traces"],
      "env_label_keys": ["env", "environment", "cube.environment", "deployment.environment"]
    },
    "elasticsearch": {
      "title": "Elasticsearch",
      "binary": "es",
      "mode": "own",
      "prefixes": ["ES_"],
      "required": ["ES_URL"],
      "optional": ["ES_USERNAME", "ES_PASSWORD", "ES_API_KEY_ID", "ES_API_KEY", "ES_TOKEN", "ES_CA_CERT", "ES_INSECURE"],
      "config_files": ["es-cli/config.yaml"],
      "always": {"ES_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"ES_READ_ONLY": "true", "ES_NO_INPUT": "true"},
      "deny_args": ["--url", "--username", "--password", "--api-key", "--api-key-id", "--token", "--ca-cert", "--insecure", "--profile", "--read-only", "--no-input", "-u", "-p", "-k"],
      "deny_commands": [["login"], ["config"], ["update"]],
      "verify": ["cluster", "health", "-o", "json"],
      "login": ["login"],
      "short_values": "of"
    },
    "jira": {
      "title": "Jira",
      "binary": "jira",
      "mode": "own",
      "prefixes": ["JIRA_"],
      "required": ["JIRA_SITE", "JIRA_TOKEN/JIRA_PASSWORD/JIRA_OAUTH_REFRESH_TOKEN"],
      "optional": ["JIRA_EMAIL", "JIRA_USER", "JIRA_AUTH_TYPE", "JIRA_CLOUD_ID", "JIRA_OAUTH_CLIENT_ID", "JIRA_OAUTH_CLIENT_SECRET"],
      "config_files": ["jira-cli/config.yaml"],
      "always": {"JIRA_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"JIRA_READ_ONLY": "true", "JIRA_NO_INPUT": "true"},
      "deny_args": ["--site", "--email", "--token", "--user", "--insecure", "--api-version", "--profile", "--read-only", "--no-input", "-s", "-e", "-t", "-u", "-k", "--out"],
      "deny_commands": [["auth"], ["update"], ["issue", "download"]],
      "verify": ["whoami", "-o", "json"],
      "login": ["auth", "login"],
      "short_values": "o",
      "command_short_values": {"issue search": "j"}
    },
    "nginxpm": {
      "title": "Nginx Proxy Manager",
      "binary": "nginxpm",
      "mode": "own",
      "prefixes": ["NGINXPM_"],
      "required": ["NGINXPM_URL", "NGINXPM_EMAIL", "NGINXPM_PASSWORD"],
      "optional": ["NGINXPM_INSECURE"],
      "config_files": ["nginxpm-cli/config.yaml"],
      "always": {"NGINXPM_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"NGINXPM_READ_ONLY": "true", "NGINXPM_NO_INPUT": "true"},
      "deny_args": ["--url", "--email", "--password", "--insecure", "--profile", "--read-only", "--no-input", "-p", "-k"],
      "deny_commands": [["login"], ["config"], ["update"]],
      "verify": ["user", "current", "-o", "json"],
      "login": ["login"],
      "short_values": "o"
    },
    "gsc": {
      "title": "Google Search Console",
      "binary": "gsc",
      "mode": "own",
      "prefixes": ["GSC_"],
      "real_home": true,
      "required": ["GSC_ACCESS_TOKEN/GSC_CREDENTIALS"],
      "optional": ["GSC_SITE", "GSC_CLIENT_ID", "GSC_CLIENT_SECRET"],
      "config_files": ["gsc-cli/config.yaml"],
      "always": {"GSC_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"GSC_READ_ONLY": "true", "GSC_NO_INPUT": "true"},
      "deny_args": ["--access-token", "--credentials", "--profile", "--config", "--read-only", "--no-input"],
      "deny_commands": [["auth", "login"], ["auth", "logout"], ["auth", "use"], ["config"], ["sites", "use"], ["update"], ["export"], ["auth", "token"]],
      "verify": ["auth", "status", "--verify", "-o", "json"],
      "login": ["auth", "login"],
      "short_values": "os",
      "agent_scrub": ["GOOGLE_APPLICATION_CREDENTIALS"],
      "resources": {"site": {"flags": ["--site", "-s"], "default_env": ["GSC_SITE"], "positional": "^(sc-domain:|https?://)", "refuse_commands": [["sites", "list"]]}}
    },
    "bing": {
      "title": "Bing Webmaster Tools",
      "binary": "bwt",
      "mode": "own",
      "prefixes": ["BWT_"],
      "real_home": true,
      "required": ["BWT_API_KEY/BWT_ACCESS_TOKEN"],
      "optional": ["BWT_SITE"],
      "config_files": ["bing-webmaster-cli/config.yaml"],
      "always": {"BWT_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"BWT_READ_ONLY": "true", "BWT_NO_INPUT": "true"},
      "deny_args": ["--access-token", "--api-key", "--profile", "--config", "--read-only", "--no-input", "--save"],
      "deny_commands": [["auth", "login"], ["auth", "logout"], ["auth", "use"], ["config"], ["sites", "use"], ["indexnow", "key"], ["update"]],
      "verify": ["auth", "status", "--verify", "-o", "json"],
      "login": ["auth", "login"],
      "short_values": "os",
      "resources": {"site": {"flags": ["--site", "-s"], "default_env": ["BWT_SITE"], "positional": "^https?://", "refuse_commands": [["sites", "list"], ["api"]]}}
    },
    "clarity": {
      "title": "Microsoft Clarity",
      "binary": "clarity",
      "mode": "own",
      "prefixes": ["CLARITY_"],
      "required": ["CLARITY_API_TOKEN"],
      "config_files": ["clarity-cli/config.yaml"],
      "always": {"CLARITY_NO_UPDATE_NOTIFIER": "1", "NO_UPDATE_NOTIFIER": "1"},
      "read_only": {"CLARITY_READ_ONLY": "true", "CLARITY_NO_INPUT": "true"},
      "deny_args": ["--token", "--profile", "--config", "--read-only", "--no-input"],
      "deny_commands": [["auth", "login"], ["auth", "logout"], ["auth", "use"], ["login"], ["config"], ["update"]],
      "verify": ["auth", "status", "--verify", "-o", "json"],
      "verify_note": "uses one of Clarity's 10 daily export requests",
      "login": ["auth", "login"],
      "short_values": "o"
    },
    "github": {
      "title": "GitHub",
      "binary": "gh",
      "mode": "allowlist",
      "prefixes": ["GH_", "GITHUB_"],
      "required": ["GH_TOKEN/GITHUB_TOKEN"],
      "optional": ["GH_HOST"],
      "config_files": ["gh/hosts.yml"],
      "always": {"GH_NO_UPDATE_NOTIFIER": "1", "GH_PROMPT_DISABLED": "1", "GH_PAGER": "cat"},
      "read_commands": [["pr", "list"], ["pr", "view"], ["pr", "diff"], ["pr", "checks"], ["pr", "status"], ["run", "list"], ["run", "view"], ["workflow", "list"], ["workflow", "view"], ["release", "list"], ["release", "view"], ["issue", "list"], ["issue", "view"], ["issue", "status"], ["repo", "view"], ["repo", "list"], ["search", "*"], ["label", "list"]],
      "deny_args": ["--web", "-w", "--hostname"],
      "verify": ["auth", "status"],
      "login": ["auth", "login", "--insecure-storage"],
      "short_values": "RLqtsAlBHSajp",
      "resources": {"repo": {"flags": ["--repo", "-R"], "default_env": ["GH_REPO"], "positional": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "refuse_commands": [["search"], ["api"]], "refuse_text": ["github.com/", "repo:"]}},
      "isolated_cwd": true
    },
    "aws": {
      "abbreviations": true,
      "title": "AWS",
      "binary": "aws",
      "mode": "allowlist",
      "prefixes": ["AWS_"],
      "required": ["AWS_REGION/AWS_DEFAULT_REGION", "AWS_ACCESS_KEY_ID/AWS_PROFILE"],
      "optional": ["AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN"],
      "config_files": ["aws/credentials", "aws/config"],
      "paths": {"AWS_CONFIG_FILE": "aws/config", "AWS_SHARED_CREDENTIALS_FILE": "aws/credentials"},
      "always": {"AWS_PAGER": ""},
      "read_commands": [["logs", "filter-log-events"], ["logs", "get-log-events"], ["logs", "describe-log-groups"], ["logs", "describe-log-streams"], ["logs", "start-query"], ["logs", "get-query-results"], ["cloudwatch", "get-metric-statistics"], ["cloudwatch", "get-metric-data"], ["cloudwatch", "list-metrics"], ["cloudwatch", "describe-alarms"], ["cloudwatch", "describe-alarm-history"], ["ecs", "describe-*"], ["ecs", "list-*"], ["elbv2", "describe-*"], ["elb", "describe-*"], ["sqs", "get-queue-attributes"], ["sqs", "list-queues"], ["rds", "describe-*"], ["ec2", "describe-*"], ["autoscaling", "describe-*"], ["eks", "describe-*"], ["eks", "list-*"], ["elasticache", "describe-*"], ["cloudtrail", "lookup-events"], ["route53", "list-*"], ["dynamodb", "describe-table"], ["dynamodb", "list-tables"], ["lambda", "list-functions"], ["sts", "get-caller-identity"], ["s3", "ls"]],
      "deny_args": ["--profile", "--endpoint-url", "--no-verify-ssl"],
      "verify": ["sts", "get-caller-identity", "--output", "json"],
      "login": ["configure"],
      "_note": "Explicit read list: broad get-* patterns also matched credential-returning and file-writing operations.",
      "resources": {"region": {"flags": ["--region"], "default_env": ["AWS_REGION", "AWS_DEFAULT_REGION"], "refuse_commands": [["s3"], ["s3api"]]}}
    },
    "kubernetes": {
      "title": "Kubernetes",
      "binary": "kubectl",
      "mode": "allowlist",
      "prefixes": ["KUBE", "AWS_"],
      "required": [],
      "config_files": ["kube/config"],
      "paths": {"KUBECONFIG": "kube/config", "AWS_CONFIG_FILE": "aws/config", "AWS_SHARED_CREDENTIALS_FILE": "aws/credentials"},
      "read_commands": [["get"], ["describe"], ["logs"], ["top"], ["events"], ["rollout", "history"], ["rollout", "status"], ["version"], ["api-resources"], ["explain"], ["auth", "can-i"], ["config", "current-context"], ["config", "get-contexts"]],
      "deny_args": ["--kubeconfig", "--context", "--cluster", "--user", "--token", "--server", "-s", "--as", "--as-group", "--username", "--password", "--insecure-skip-tls-verify", "--raw", "-f", "--filename", "-k", "--kustomize", "-R", "--recursive", "--client-certificate", "--client-key", "--certificate-authority", "--tls-server-name", "--as-uid"],
      "verify": ["get", "ns", "-o", "name", "--request-timeout=15s"],
      "short_values": "onlcL",
      "resources": {"namespace": {"flags": ["--namespace", "-n"], "refuse_flags": ["-A", "--all-namespaces"], "refuse_kinds": ["namespace", "namespaces", "ns", "node", "nodes", "no", "persistentvolume", "persistentvolumes", "pv", "clusterrole", "clusterroles", "clusterrolebinding", "clusterrolebindings", "storageclass", "storageclasses", "sc", "customresourcedefinition", "customresourcedefinitions", "crd", "crds", "apiservice", "apiservices", "all"]}}
    },
    "postgres": {
