      "prefixes": ["MYSQL_"],
      "required": ["MYSQL_HOST", "MYSQL_USER"],
      "optional": ["MYSQL_TCP_PORT", "MYSQL_PWD", "MYSQL_DATABASE"],
      "deny_args": ["-h", "--host", "-u", "--user", "--defaults-file", "--defaults-extra-file", "--no-defaults", "--init-command", "-p", "--password", "-P", "--port", "-S", "--socket"],
      "verify": ["-e", "SELECT 1"],
      "short_values": "eD",
      "option_aliases": true,
      "deny_prefixes": ["--password"]
    },
    "mongodb": {
      "abbreviations": true,
      "title": "MongoDB",
      "binary": "mongosh",
      "mode": "approval",
      "prefixes": ["MONGODB_"],
      "required": ["MONGODB_URI"],
      "deny_args": ["--host", "--port", "-u", "--username", "-p", "--password", "--nodb", "--authenticationDatabase", "--apiKey"],
      "verify": ["--quiet", "--eval", "db.runCommand({ping:1})"]
    },
    "clickhouse": {
      "abbreviations": true,
      "title": "ClickHouse",
      "binary": "clickhouse",
      "subcommand": ["client"],
      "mode": "approval",
      "prefixes": ["CLICKHOUSE_"],
      "required": ["CLICKHOUSE_HOST", "CLICKHOUSE_USER", "CLICKHOUSE_PASSWORD"],
      "optional": ["CLICKHOUSE_PORT", "CLICKHOUSE_DATABASE", "CLICKHOUSE_SECURE"],
