      "title": "Sentry",
      "binary": "sentry",
      "mode": "allowlist",
      "prefixes": ["SENTRY_"],
      "required": ["SENTRY_AUTH_TOKEN/SENTRY_TOKEN"],
      "optional": ["SENTRY_HOST", "SENTRY_URL", "SENTRY_ORG", "SENTRY_PROJECT"],
      "paths": {"SENTRY_CONFIG_DIR": "sentry"},
      "config_files": ["sentry/cli.db"],
      "real_home": false,
      "always": {"SENTRY_FORCE_ENV_TOKEN": "1", "SENTRY_CLI_NO_TELEMETRY": "1", "SENTRY_CLI_NO_UPDATE_CHECK": "1", "SENTRY_CLI_NO_AUTO_REPAIR": "1", "SENTRY_OUTPUT_FORMAT": "json", "SENTRY_NO_GRAPHICS": "1"},
      "read_commands": [["auth", "whoami"], ["org", "list"], ["org", "view"], ["project", "list"], ["issue", "list"], ["issue", "view"], ["issue", "events"], ["event", "list"], ["event", "view"], ["log", "list"], ["log", "view"], ["trace", "list"], ["trace", "view"], ["trace", "logs"], ["span", "list"], ["span", "view"], ["release", "list"], ["release", "view"], ["release", "deploys"], ["repo", "list"], ["team", "list"], ["monitor", "list"], ["dashboard", "list"], ["dashboard", "view"], ["dashboard", "revisions"]],
      "deny_args": ["--org", "--project", "--token", "--url", "--scope", "--read-only", "--web", "-w", "--no-web", "--force", "--no-force", "--show-token", "--no-show-token", "--refresh", "-r"],
      "deny_commands": [["auth", "login"], ["auth", "logout"], ["auth", "refresh"], ["auth", "token"], ["cli"], ["init"], ["local"], ["mcp"], ["api"], ["dsn"], ["project", "view"], ["issue", "explain"], ["issue", "plan"], ["replay", "download"]],
      "short_values": "ncqstepr",
      "verify": ["org", "list", "--limit", "1", "--json", "--fresh"],
      "login": ["auth", "login", "--read-only"],
      "isolated_cwd": true,
      "_note": "project view returns a DSN and is excluded. Positional org/project selectors remain usable within token permissions."
    },
    "cloudflare": {
      "title": "Cloudflare",
      "binary": "cf",
      "mode": "allowlist",
      "prefixes": ["CLOUDFLARE_", "CF_"],
